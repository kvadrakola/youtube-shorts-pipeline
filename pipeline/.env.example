# Copy to .env and fill in. Never commit .env.

# Hugging Face (gated Pyannote models)
HF_TOKEN=

# Clip selection and translation
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Optional overrides
DEVICE=cuda
WHISPER_MODEL=large-v3
WHISPER_BATCH_SIZE=16
# WHISPER_LANGUAGE=en
# WHISPER_INITIAL_PROMPT=Proper nouns and niche vocabulary for your channel.
# CLIP_SELECTOR_CONTEXT=Optional extra paragraph for clip-selection prompts (niche / tone).
# TRANSLATION_CONTENT_DOMAIN=long-form spoken video
# TRANSLATION_GLOSSARY_JSON={"Product":{"es":"Producto","ru":"Продукт"}}
# TRANSLATION_LATIN_ALLOWLIST=ProductName,Acronym

# Branding (YouTube metadata and outro card)
BRAND_NAME=Example Channel
BRAND_WEBSITE_URL=https://example.com
BRAND_SOCIAL_HANDLE=@ExampleChannel
# Presenter or channel name on the default outro badge (HTML id: outro-scholar-badge)
BRAND_OUTRO_SCHOLAR_BADGE=Example Channel
BRAND_OUTRO_HEADLINE_EN=Discover more from\nyour channel
BRAND_OUTRO_TAGLINE_EN=Turn long-form talks into Shorts with captions, outros, and upload-ready metadata.

# Outro (optional)
# BRAND_OUTRO_PATH=assets/outro_rendered.mp4
# BRAND_OUTRO_TRANSITION_SECONDS=0.5
#
# Custom outro — use ONE of:
# 1) Pre-rendered MP4 (H.264 + AAC, 1080x1920 recommended) for all languages:
# BRAND_OUTRO_CUSTOM_MP4=assets/outro/custom/my_outro.mp4
# 2) Per-language MP4s under a directory (outro_en.mp4, outro_es.mp4, outro_ru.mp4):
# BRAND_OUTRO_CUSTOM_DIR=assets/outro/custom
# 3) HTML template rendered via Playwright (default neutral card):
# OUTRO_HTML_PATH=../poster/outro_card_template/code.html
# Optional outro bed music (leave empty for silent audio). Do not commit copyrighted tracks.
# OUTRO_MUSIC_URL=
# OUTRO_MUSIC_PATH=assets/audio/outro_music.mp3

YTDLP_SLEEP_INTERVAL=30
COOKIES_FILE_PATH=cookies.txt
